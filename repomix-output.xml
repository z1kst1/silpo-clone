<file path="frontend/src/styles/account.css">
.profile-page,
.orders-page {
  max-width: 1280px;
  margin: 0 auto;
  padding: 42px 32px;
}

.profile-layout {
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 24px;
  align-items: start;
}

.profile-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 28px;
  text-align: center;
}

.profile-avatar {
  width: 86px;
  height: 86px;
  margin: 0 auto 18px;
  border-radius: 50%;
  background: var(--green);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34px;
  font-weight: 700;
}

.profile-card h2 {
  margin: 0 0 8px;
  font-size: 30px;
}

.profile-role {
  margin: 0 0 22px;
  color: var(--muted);
  font-size: 16px;
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-align: left;
}

.profile-info__row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.profile-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.profile-action-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 24px;
  transition: 0.2s ease;
}

.profile-action-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 18px rgba(0, 0, 0, 0.08);
}

.profile-action-card h3 {
  margin: 0 0 10px;
  font-size: 24px;
}

.profile-action-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.order-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 24px;
}

.order-card__top {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: start;
  margin-bottom: 18px;
}

.order-card__id {
  margin: 0 0 6px;
  font-size: 22px;
  font-weight: 700;
}

.order-card__date {
  color: var(--muted);
  font-size: 14px;
}

.order-card__status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  padding: 0 14px;
  border-radius: 999px;
  background: #e7f8ec;
  color: var(--green);
  font-weight: 700;
  font-size: 14px;
}

.order-card__customer {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px 18px;
  margin-bottom: 20px;
  padding: 18px;
  border-radius: 18px;
  background: #fafafa;
  border: 1px solid #f0f0f0;
}

.order-card__customer p {
  margin: 0;
  line-height: 1.5;
}

.order-card__items {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 20px;
}

.order-item {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f4f4f4;
}

.order-item__left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.order-item__image {
  width: 74px;
  height: 74px;
  object-fit: cover;
  border-radius: 14px;
  background: #efefef;
}

.order-item__name {
  margin: 0 0 6px;
  font-weight: 700;
}

.order-item__meta {
  color: var(--muted);
  font-size: 14px;
}

.order-card__bottom {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.order-total-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
}

.order-total-row--main {
  font-size: 20px;
  font-weight: 700;
  margin-top: 6px;
}

.orders-empty {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 48px 32px;
  text-align: center;
}

.orders-empty h1 {
  margin: 0 0 14px;
  font-size: 38px;
}

.orders-empty p {
  max-width: 680px;
  margin: 0 auto 24px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
}

.checkout-success__id {
  margin-top: -8px;
  margin-bottom: 24px;
  font-size: 18px;
  color: var(--text);
}

