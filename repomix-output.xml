          {/* ПІДСУМОК */}
          <div style={{ width: "400px", backgroundColor: "#fff", borderRadius: "32px", padding: "36px", boxShadow: "0 8px 32px rgba(0,0,0,0.04)", border: "1px solid rgba(0,0,0,0.02)", position: "sticky", top: "40px" }}>
