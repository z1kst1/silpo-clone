}

.details-avatar {
  width: 80px;
  height: 80px;
  background-color: #e2e2e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* =========================================
   СТИЛІ ДЛЯ АВАТАРУ В "МОЇ ДАНІ"
========================================= */

.details-avatar {
  /* Існуючі стилі кола аватару */
  width: 80px;
  height: 80px;
  background-color: #e2e2e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative; /* Потрібно для позиціонування кнопки хрестика/плюса */
}

/* ОНОВЛЕНО: Універсальна кнопка дії (плюс або хрестик) */
.avatar-action-btn {
  position: absolute;
