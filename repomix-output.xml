<file path="frontend/src/styles/kalpo-home.css">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

/* =========================================
   ГОЛОВНА СТОРІНКА (НОВИЙ ДИЗАЙН)
========================================= */

.kalpo-home-wrapper {
  background-color: #FAEDD2;
  min-height: 100vh;
  padding: 30px 0 60px 0;
  display: flex;
  justify-content: center;
  font-family: 'Inter', sans-serif;
}

.kalpo-home-content {
  width: 100%;
  max-width: 1320px;
  padding: 0 24px;
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.kalpo-slots {
  display: none !important;
}

/* --- HERO СЕКЦІЯ (Банер + 4 картки) --- */
.kalpo-hero {
  display: flex;
  gap: 20px;
  height: 280px;
}

.kalpo-hero__banner {
  flex: 1;
  background-color: #7ec34c; /* Колір як у Фігмі */
  border-radius: 24px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0; /* Прибираємо відступи на комп'ютері */
  overflow: hidden;
}

.kalpo-hero__banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Завдяки цьому картинка ідеально заповнить блок і нічого не обріжеться */
  display: block;
}

.kalpo-hero__brand {
  color: white;
  font-weight: 700;
  font-size: 20px;
  letter-spacing: 2px;
  margin-bottom: 10px;
}

.kalpo-hero__banner-content h2 {
  color: white;
  font-size: 42px;
  line-height: 1.1;
  margin: 0;
}

.kalpo-hero__discount {
  background-color: white;
  color: #CC0000;
  font-size: 32px;
  font-weight: 800;
  padding: 10px 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 110px;
  height: 110px;
  margin-left: auto;
  transform: rotate(-10deg);
}

.kalpo-hero__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.9);
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #333;
  z-index: 10;
}
.kalpo-hero__arrow.left { left: 15px; }
.kalpo-hero__arrow.right { right: 15px; }

.kalpo-hero__cards {
  width: 440px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 16px;
  flex-shrink: 0;
}

.kalpo-hero__promo-card {
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.kalpo-hero__promo-card:hover {
  transform: translateY(-2px);
}

.kalpo-hero__promo-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* --- БІЛІ СЕКЦІЇ ТОВАРІВ --- */
.kalpo-section-block {
  background-color: #ffffff;
  border-radius: 24px;
  padding: 30px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.02);
}

.kalpo-section-block--holiday {
  background-color: #8E1616;
}

.kalpo-section__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.kalpo-section__head-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.kalpo-section__icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 700;
}

.kalpo-section__icon--green {
  background-color: #e6f4ea;
  color: #34a853;
}

.kalpo-section__icon--red {
  background-color: #fceceb;
  color: #8E1616;
}

.kalpo-section__titles h2 {
  margin: 0 0 4px 0;
  font-size: 24px;
  color: #1a1a1a;
  font-weight: 700;
}

.kalpo-section__titles p {
  margin: 0;
  font-size: 14px;
  color: #666;
}

.kalpo-section__head-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.kalpo-section__link {
  color: #1a1a1a;
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
}

.kalpo-section__link--light {
  color: white;
}

.kalpo-nav-arrows {
  display: flex;
  gap: 8px;
}

.kalpo-nav-arrows button {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: none;
  background: #f5f5f5;
  color: #333;
  cursor: pointer;
}

.kalpo-section-block--holiday .kalpo-nav-arrows button {
  background: rgba(255,255,255,0.2);
  color: white;
}

/* --- КАРУСЕЛЬ --- */
.kalpo-products-carousel {
  display: flex;
  gap: 18px;
  overflow-x: auto;
  padding-bottom: 10px;
  scrollbar-width: none;
  padding-right: 20px;
}

.kalpo-products-carousel::-webkit-scrollbar {
  display: none;
}

.carousel-item {
  flex: 0 0 220px; /* Ширина картки в каруселі */
}


/* ================= RECIPES ================= */

.kalpo-recipes__grid {
  background: #f4f4f4;
  border-radius: 28px;
  padding: 14px 20px 24px;
  display: grid;
  grid-template-columns: 260px repeat(5, 1fr);
  gap: 14px;
}

.kalpo-recipes__intro {
  background: #a90f13;
  color: white;
  border-radius: 24px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.kalpo-recipes__intro h3 {
  margin: 0 0 8px;
  font-size: 34px;
  line-height: 1.1;
}

.kalpo-recipes__intro p {
  margin: 0 0 18px;
  color: #f8d7d7;
}

.kalpo-recipes__intro button {
  border: none;
  border-radius: 999px;
  background: #f8d6a0;
  color: #84221f;
  padding: 12px 16px;
  font-weight: 700;
  cursor: pointer;
}

.kalpo-recipe-card {
  position: relative;
  overflow: hidden;
  border-radius: 22px;
  min-height: 280px;
}

.kalpo-recipe-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.kalpo-recipe-card__overlay {
  position: absolute;
  inset: auto 0 0 0;
  padding: 14px;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
  color: white;
}

.kalpo-recipe-card__overlay span {
  display: inline-block;
  margin-bottom: 8px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 12px;
}

.kalpo-recipe-card__overlay h4 {
  margin: 0;
  font-size: 18px;
  line-height: 1.3;
}

/* ================= INFO ================= */

.kalpo-info {
  background: #eceef3;
  border-radius: 24px;
  padding: 54px;
}

.kalpo-info h2 {
  margin: 0 0 18px;
  font-size: 42px;
  line-height: 1.15;
  color: #222;
}

.kalpo-info h3 {
  margin: 30px 0 12px;
  font-size: 30px;
  color: #222;
}

.kalpo-info p {
  margin: 0;
  color: #555;
  line-height: 1.7;
  font-size: 18px;
}

.kalpo-info__more {
  margin-top: 28px;
  border: none;
  background: transparent;
  color: #265cb8;
  font-weight: 700;
  cursor: pointer;
  padding: 0;
}

/* ================= HEADER ================= */

.kalpo-header {
  background: #e9ddb8;
  border-bottom: 1px solid #d8ca9f;
  position: sticky;
  top: 0;
  z-index: 50;
}

.kalpo-header__inner {
  max-width: 1320px;
  margin: 0 auto;
  padding: 12px 24px 10px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 24px; /* Збільшили відступ між лого і кнопкою */
  align-items: center;
}

.kalpo-header__left {
  display: flex;
  align-items: center;
  gap: 16px; /* Відступ між самими елементами зліва */
}

.kalpo-header__left,
.kalpo-header__right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.kalpo-header__burger-wrap {
  position: relative;
}

.kalpo-header__burger {
  width: 52px;
  height: 52px;
  border: 1px solid #ccb98d;
  background: #f7efd9;
  border-radius: 50%;
  padding: 0;
  font-size: 22px;
  color: #8c2f23;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}

.kalpo-header__menu {
  position: absolute;
  top: 60px;
  left: 0;
  min-width: 220px;
  background: #fbf7ee;
  border: 1px solid #d8ca9f;
  border-radius: 18px;
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  z-index: 100;
}

.kalpo-header__menu-link {
  display: block;
  text-decoration: none;
  color: #5b3324;
  font-size: 15px;
  font-weight: 600;
  padding: 12px 14px;
  border-radius: 12px;
  transition: 0.2s ease;
}

.kalpo-header__menu-link:hover {
  background: #f1e6cd;
}

.kalpo-header__logo-link {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}

.kalpo-header__logo-image {
  height: 58px;
  width: auto;
  display: block;
}

.kalpo-header__catalog,
.kalpo-header__action {
  min-height: 40px;
  padding: 0 18px;
  border: 1px solid #c94939;
  border-radius: 999px;
  background: #f8f1dc;
  color: #5d2f24;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  transition: 0.2s ease;
}

.kalpo-header__catalog:hover,
.kalpo-header__action:hover {
  background: #f4ead1;
}

.kalpo-header__action--cart {
  background: linear-gradient(90deg, #e4c39f 0%, #d6ae84 100%);
  border-color: transparent;
  padding: 0 22px;
}

.kalpo-header__action--cart:hover {
  background: linear-gradient(90deg, #ddb88f 0%, #cfa276 100%);
}

.kalpo-header__search {
  width: 100%;
}

.kalpo-header__search input {
  width: 100%;
  height: 46px;
  border-radius: 999px;
  border: 1px solid #c94939;
  background: #fbf7ee;
  padding: 0 18px;
  outline: none;
  font-size: 14px;
  color: #5a3424;
}

.kalpo-header__search input::placeholder {
  color: #a1988d;
}

.kalpo-header__delivery {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #5a3424;
}

.kalpo-header__delivery-icon {
  font-size: 16px;
  line-height: 1;
  color: #c94939;
}

.kalpo-header__delivery-title {
  font-size: 13px;
  font-weight: 700;
  line-height: 1.05;
}

.kalpo-header__delivery-text {
  font-size: 12px;
  line-height: 1.1;
}

.kalpo-header__slots {
  max-width: 1320px;
  margin: 0 auto;
  padding: 6px 24px 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.kalpo-header__slot-button {
  min-height: 36px;
  padding: 0 16px;
  border: 1px solid #bca97f;
  border-radius: 999px;
  background: #f5eed9;
  color: #5b3324;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  line-height: 1;
  white-space: nowrap;
  transition: 0.2s ease;
}

.kalpo-header__slot-button:hover {
  background: #f1e6cd;
}

.kalpo-header__slot-button--accent {
  font-weight: 700;
}

.kalpo-header__slot-button--accent::before {
  content: "⚡ ";
  color: #c94939;
}

/* ================= CATALOG PAGE ================= */

.catalog-page {
  background: #eceef3;
  min-height: calc(100vh - 80px);
  padding: 28px 24px 40px;
}

.catalog-layout {
  max-width: 1320px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 24px;
  align-items: start;
}

.catalog-sidebar {
  background: #f8f6f1;
  border: 1px solid #ddd2b6;
  border-radius: 24px;
  padding: 22px;
  position: sticky;
  top: 90px;
}

.catalog-sidebar__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.catalog-sidebar__top h3 {
  margin: 0;
  font-size: 26px;
  color: #2c2c2c;
}

.catalog-clear-button {
  border: none;
  background: transparent;
  color: #2d7c2f;
  font-weight: 700;
  cursor: pointer;
}

.catalog-search-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 22px;
}

.catalog-search-input {
  min-height: 46px;
  border-radius: 14px;
  border: 1px solid #cdbf9e;
  padding: 0 14px;
  background: white;
  outline: none;
}

.catalog-search-input:focus {
  border-color: #8faf43;
}

.catalog-search-button {
  width: 100%;
}

.filter-group {
  padding-top: 18px;
  border-top: 1px solid #e4dac4;
  margin-top: 18px;
}

.filter-title {
  margin: 0 0 12px;
  font-size: 18px;
  font-weight: 700;
  color: #303030;
}

.filter-label {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  color: #555;
  cursor: pointer;
}

.filter-label input {
  accent-color: #69a623;
}

.catalog-content {
  min-width: 0;
}

.catalog-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.catalog-toolbar .section-title h1 {
  margin: 0 0 6px;
  font-size: 44px;
  color: #232323;
}

.catalog-toolbar .section-title p {
  margin: 0;
  color: #656565;
  font-size: 17px;
}

.catalog-sort {
  min-width: 240px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.catalog-sort label {
  font-weight: 700;
  color: #303030;
}

.catalog-sort select {
  min-height: 44px;
  border-radius: 14px;
  border: 1px solid #cdbf9e;
  padding: 0 14px;
  background: #fff;
  outline: none;
}

.catalog-active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 16px;
}

.catalog-chip {
  border: none;
  border-radius: 999px;
  background: #dceec0;
  color: #335d14;
  padding: 8px 14px;
  font-weight: 700;
  cursor: pointer;
}

.catalog-results-count {
  margin: 0 0 18px;
  color: #474747;
  font-size: 16px;
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.catalog-empty {
  background: #f8f6f1;
  border: 1px solid #ddd2b6;
  border-radius: 24px;
  padding: 28px;
}

.catalog-empty h2 {
  margin: 0 0 10px;
  color: #232323;
}

.catalog-empty p {
  margin: 0;
  color: #666;
}

/* ================= PRODUCT CARD ================= */

.product-card {
  background: #ffffff;
  border: 1px solid #e5dcc7;
  border-radius: 24px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100%;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
}

.product-card__image-link {
  display: block;
  background: #fbf8f2;
  padding: 16px;
}

.product-card__image {
  width: 100%;
  height: 220px;
  object-fit: contain;
  display: block;
}

.product-card__content {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 18px;
  flex: 1;
}

.product-card__category {
  margin: 0;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #6a8f2a;
}

.product-card__title-link {
  text-decoration: none;
}

.product-card__title {
  margin: 0;
  font-size: 22px;
  line-height: 1.25;
  color: #232323;
}

.product-card__description {
  margin: 0;
  color: #666;
  font-size: 15px;
  line-height: 1.5;
  min-height: 45px;
}

.product-card__price {
  margin: 0;
  font-size: 28px;
  font-weight: 800;
  color: #202020;
}

.product-card__bottom {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.product-card__button {
  width: 100%;
  justify-content: center;
  text-align: center;
  text-decoration: none;
}

/* ================= AUTH MODAL ================= */

.auth-modal-page {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.48);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 86px;
}

.auth-modal-backdrop {
  width: 100%;
  display: flex;
  justify-content: center;
}

.auth-modal-card {
  position: relative;
  width: 360px;
  background: #ffffff;
  border-radius: 0;
  padding: 28px 24px 18px;
  box-shadow: none;
}

.auth-modal-card--register {
  width: 390px;
}

.auth-modal-close {
  display: none;
}

.auth-modal-logo {
  width: 150px;
  height: 150px;
  margin: -8px auto 26px;
  border-radius: 50%;
  background: #f1dda0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-modal-logo img {
  width: 116px;
  height: auto;
  display: block;
}

.auth-modal-title {
  margin: 0 0 16px;
  text-align: left;
  font-size: 24px;
  color: #111111;
  font-weight: 800;
}

.auth-modal-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.auth-modal-form label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  font-weight: 700;
  color: #111111;
}

.auth-modal-form input {
  width: 100%;
  height: 42px;
  border: 1px solid #d7d7d7;
  border-radius: 6px;
  padding: 0 12px;
  background: #ffffff;
  color: #2a2a2a;
  outline: none;
  font-size: 13px;
  box-sizing: border-box;
}

.auth-modal-form input::placeholder {
  color: #9a9a9a;
}

.auth-modal-form input:focus {
  border-color: #e23b35;
}

.auth-modal-form button {
  height: 42px;
  border: none;
  border-radius: 999px;
  background: #2f55d4;
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
}

.auth-modal-form button:hover {
  background: #284ac0;
}

.auth-modal-form button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.auth-modal-bottom {
  margin: 10px 0 0;
  text-align: left;
  font-size: 12px;
  color: #111111;
  font-weight: 600;
}

.auth-modal-bottom a {
  color: #2f55d4;
  font-weight: 800;
  text-decoration: none;
}

.auth-modal-help {
  display: block;
  margin: 26px 0 0 auto;
  border: none;
  background: transparent;
  color: #555555;
  font-size: 12px;
  cursor: pointer;
}

.auth-modal-success,
.auth-modal-error {
  margin: 10px 0 0;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 13px;
}

.auth-modal-success {
  background: #e5f4df;
  color: #2d6b23;
}

.auth-modal-error {
  background: #fff1ee;
  color: #b83d31;
}

/* ================= PROFILE PAGE ================= */

.profile-page {
  background: #f7f7f7;
  min-height: calc(100vh - 120px);
}

.profile-shell {
  max-width: 1320px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 210px 1fr;
  min-height: calc(100vh - 120px);
}

.profile-sidebar {
  background: #f5e7c9;
  padding: 22px 14px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.profile-menu {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.profile-menu__item {
  border: none;
  background: transparent;
  color: #5b3324;
  text-align: left;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.profile-menu__item--active {
  background: #ead0ad;
  color: #9f1013;
}

.profile-help-button {
  border: none;
  background: transparent;
  color: #9f1013;
  font-size: 13px;
  cursor: pointer;
  text-align: left;
  padding: 10px 14px;
}

.profile-main {
  padding: 28px 34px 36px;
}

.profile-title {
  margin: 0;
  font-size: 34px;
  color: #191919;
}

.profile-subtitle {
  margin: 4px 0 22px;
  color: #777;
  font-size: 14px;
}

.profile-welcome-card,
.profile-block,
.profile-promo {
  background: #ffffff;
  border: 1px solid #eeeeee;
  border-radius: 16px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
}

.profile-welcome-card {
  padding: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}

.profile-user {
  display: flex;
  align-items: center;
  gap: 18px;
}

.profile-avatar {
  width: 74px;
  height: 74px;
  border-radius: 16px;
  background: #f8f1ee;
  color: #9f1013;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34px;
}

.profile-user h2 {
  margin: 0 0 8px;
  font-size: 22px;
  color: #191919;
}

.profile-user p {
  margin: 4px 0;
  color: #666;
  font-size: 14px;
}

.profile-red-button {
  border: none;
  background: #9f1013;
  color: white;
  padding: 12px 20px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.profile-block {
  padding: 22px;
  min-height: 210px;
}

.profile-block h3 {
  margin: 0 0 4px;
  color: #333;
  font-size: 18px;
}

.profile-block__hint {
  margin: 0 0 18px;
  color: #888;
  font-size: 13px;
}

.profile-row,
.profile-order,
.profile-security-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 9px 0;
  border-bottom: 1px solid #f0f0f0;
  color: #555;
  font-size: 14px;
}

.profile-row b,
.profile-order b {
  color: #333;
  font-weight: 600;
  text-align: right;
}

.profile-row--address {
  grid-template-columns: 1fr 1.5fr;
}

.profile-security-row {
  grid-template-columns: 1fr auto;
}

.profile-security-row span {
  color: #328a35;
  font-weight: 700;
}

.profile-link-button {
  margin-top: 16px;
  border: none;
  background: transparent;
  color: #9f1013;
  font-weight: 700;
  cursor: pointer;
  padding: 0;
}

.profile-outline-button {
  width: 100%;
  margin-top: 18px;
  height: 38px;
  border: 1px solid #c94939;
  border-radius: 8px;
  background: white;
  color: #9f1013;
  font-weight: 700;
  cursor: pointer;
}

.profile-promo {
  margin-top: 18px;
  padding: 18px 22px;
  display: grid;
  grid-template-columns: 70px 1fr auto;
  gap: 18px;
  align-items: center;
}

.profile-promo__icon {
  width: 60px;
  height: 60px;
  border-radius: 14px;
  background: #f8f1ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
}

.profile-promo h3 {
  margin: 0 0 4px;
  font-size: 18px;
}

.profile-promo p {
  margin: 0;
  color: #777;
  font-size: 14px;
}

/* ================= RESPONSIVE ================= */

@media (max-width: 1200px) {
  .kalpo-products-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .kalpo-recipes__grid {
    grid-template-columns: 1fr 1fr;
  }

  .kalpo-recipes__intro {
    grid-column: 1 / -1;
  }

  .kalpo-hero {
    grid-template-columns: 1fr;
  }

  .catalog-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1100px) {
  .kalpo-header__inner {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .kalpo-header__right {
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}

@media (max-width: 900px) {
  .kalpo-header__right {
    flex-wrap: wrap;
  }

  .kalpo-products-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .kalpo-hero__cards {
    grid-template-columns: 1fr;
  }

  .catalog-layout {
    grid-template-columns: 1fr;
  }

  .catalog-sidebar {
    position: static;
  }

  .catalog-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .profile-shell {
    grid-template-columns: 1fr;
  }

  .profile-sidebar {
    display: none;
  }

  .profile-main {
    padding: 22px;
  }

  .profile-grid {
    grid-template-columns: 1fr;
  }

  .profile-welcome-card,
  .profile-promo {
    grid-template-columns: 1fr;
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 700px) {
  .kalpo-header__left,
  .kalpo-header__right {
    flex-wrap: wrap;
  }

  .kalpo-header__logo-image {
    height: 46px;
  }

  .kalpo-header__catalog,
  .kalpo-header__action {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }

  .kalpo-header__slot-button {
    min-height: 42px;
    padding: 0 16px;
    font-size: 14px;
  }
}

@media (max-width: 640px) {
  .kalpo-products-grid,
  .kalpo-recipes__grid {
    grid-template-columns: 1fr;
  }

  .kalpo-hero__banner {
  flex: 1;
  border-radius: 24px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0;
  overflow: hidden;
  background-color: #8cc63f;
}

.kalpo-hero__banner-img {
  width: 100%;
  height: 100%;
  object-fit: contain !important;
  object-position: center !important;
  display: block;
}

  .kalpo-hero__banner-content h2 {
    font-size: 34px;
  }

  .kalpo-section__head {
    flex-direction: column;
  }

  .catalog-page {
    padding: 20px 14px 32px;
  }

  .catalog-grid {
    grid-template-columns: 1fr;
  }

  .catalog-toolbar .section-title h1 {
    font-size: 32px;
  }

  .product-card__image {
    height: 190px;
  }

  .auth-modal-page {
    align-items: center;
    padding: 28px 14px;
  }

  .auth-modal-card,
  .auth-modal-card--register {
    width: 100%;
    max-width: 390px;
  }

  .auth-modal-logo {
    width: 130px;
    height: 130px;
  }

  .auth-modal-logo img {
    width: 100px;
  }

  .auth-modal-title {
    font-size: 24px;
  }

  /* --- Стилі для банера з Кефіром --- */
.kalpo-hero__banner {
  flex: 1;
  border-radius: 24px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0; /* Прибрали відступи, щоб картинка була на весь блок */
  overflow: hidden;
  background-color: #7ec34c;
}

.kalpo-hero__banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* --- Стилі для кнопки "Всі товари" в Header --- */
.kalpo-header__catalog {
  min-height: 40px;
  padding: 0 16px;
  border: 1px solid #8b181b; /* Бордова рамка */
  border-radius: 999px;
  background: transparent;
  color: #8b181b; /* Бордовий текст і іконки */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: 0.2s ease;
}

.kalpo-header__catalog:hover {
  background: rgba(139, 24, 27, 0.05);
}

.kalpo-hero__promo-card.pure-css-card {
  background-color: #ffffff;
  border: none;
  padding: 20px;
  cursor: pointer;
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.2s ease;
  position: relative;
  text-align: left;
  box-shadow: 0 4px 10px rgba(0,0,0,0.03);
  display: block;
  height: 100%;
}

.pure-card-title {
  font-size: 16px !important;
  font-weight: 700 !important;
  color: #8b181b !important; /* Примусовий бордовий колір */
  position: relative;
  z-index: 2;
  display: block;
}

/* 3. Бордові крапки гарантовано відображаються */
.pure-card-dots {
  position: absolute;
  bottom: -15px;
  right: -15px;
  width: 95px;
  height: 95px;
