import { useState } from "react";
import { Link, useNavigate } from "react-router";
import { useCart } from "../context/CartContext";
import api from "../api/api";
import { createCheckoutSession } from "../api/stripe";

export default function CheckoutPage() {
  const navigate = useNavigate();
  const { cartItems, subtotal, clearCart } = useCart();

  const deliveryCost = 79;
  const total = subtotal + deliveryCost;

  const [form, setForm] = useState({
    firstName: "",
    lastName: "",
    phone: "",
    email: "",
    address: "",
    comment: "",
    paymentMethod: "card",
  });

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [error, setError] = useState("");

  function handleChange(e) {
    const { name, value } = e.target;
    setForm((prev) => ({ ...prev, [name]: value }));
  }

  async function handleSubmit(e) {
    e.preventDefault();
    setError("");

    if (!form.firstName || !form.phone || !form.address) {
      setError("Заповніть всі обов'язкові поля");
      return;
    }

    if (cartItems.length === 0) {
      setError("Кошик порожній");
      return;
    }

    setIsSubmitting(true);

    try {
      // ✅ Поля приведені у відповідність до схеми Prisma Ярослава:
      // Order { total, address, status, paymentMethod, comment, items: OrderItem[] }
      const orderData = {
        items: cartItems.map((item) => ({
          productId: item.id,
          name: item.name || item.title,
          quantity: item.quantity,
          price: Number(item.price),
        })),
        total: total,
        address: form.address,
        comment: form.comment,
        paymentMethod: form.paymentMethod,
      };

      // ✅ Якщо обрана "Картка онлайн" — створюємо замовлення зі статусом
      // "очікує оплати" і одразу перенаправляємо на Stripe Checkout.
      // Якщо готівка/термінал — як раніше, відразу підтверджуємо замовлення.
      if (form.paymentMethod === "card") {
        const order = await api.post("/orders", orderData);
        const orderId = order.data.id;

        const session = await createCheckoutSession({
          orderId,
          items: cartItems.map((item) => ({
            name: item.name || item.title,
            price: Number(item.price),
            quantity: item.quantity,
          })),
        });

        // Stripe Checkout сам редіректить на свою сторінку оплати.
        // Картку приймає лише ВІН (тестова картка 4242 4242 4242 4242),
        // дані картки ніколи не проходять через наш сервер.
        window.location.href = session.url;
        return;
      }

      // Готівка / термінал при отриманні — без оплати онлайн
      await api.post("/orders", orderData);
      await clearCart();
      navigate("/order-success");
    } catch (err) {
      console.error("Помилка оформлення:", err);

      if (err.response?.status === 401) {
        setError("Увійдіть в акаунт, щоб оформити замовлення");
      } else {
        setError(
          err.response?.data?.error ||
            "Не вдалося оформити замовлення. Спробуйте ще раз."
        );
      }
    } finally {
      setIsSubmitting(false);
    }
  }

  // Якщо кошик порожній — редірект
  if (cartItems.length === 0) {
    return (
      <div style={{ backgroundColor: "#F5E6BE", minHeight: "100vh", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", fontFamily: "system-ui, sans-serif", padding: "20px" }}>
        <h2 style={{ fontSize: "24px", fontWeight: "800", marginBottom: "16px" }}>Кошик порожній</h2>
        <p style={{ color: "#555", marginBottom: "24px" }}>Додайте товари, щоб оформити замовлення</p>
        <Link to="/catalog" style={{ backgroundColor: "#8b181b", color: "#fff", padding: "14px 36px", borderRadius: "24px", textDecoration: "none", fontWeight: "700" }}>
          До каталогу
        </Link>
      </div>
    );
  }

  const inputStyle = {
    width: "100%", padding: "12px 16px", borderRadius: "12px",
    border: "1px solid #e0e0e0", fontSize: "15px", outline: "none",
    backgroundColor: "#fafafa", boxSizing: "border-box",
  };

  const labelStyle = {
    display: "block", fontSize: "13px", fontWeight: "600",
    color: "#555", marginBottom: "6px",
  };

  return (
    <div style={{ backgroundColor: "#f9f6f0", minHeight: "100vh", paddingBottom: "60px", fontFamily: "system-ui, sans-serif" }}>
      <div style={{ maxWidth: "1200px", margin: "0 auto", padding: "40px 24px" }}>

        {/* ЗАГОЛОВОК */}
        <div style={{ marginBottom: "32px" }}>
          <Link to="/cart" style={{ color: "#8b181b", textDecoration: "none", fontSize: "14px", fontWeight: "600", display: "flex", alignItems: "center", gap: "6px", marginBottom: "16px" }}>
            ❮ Повернутись до кошика
          </Link>
          <h1 style={{ fontSize: "32px", fontWeight: "800", color: "#202124", margin: 0 }}>Оформлення замовлення</h1>
        </div>

        <form onSubmit={handleSubmit}>
          <div style={{ display: "flex", gap: "32px", alignItems: "flex-start" }}>

            {/* ЛІВА ЧАСТИНА — ФОРМА */}
            <div style={{ flex: 1, display: "flex", flexDirection: "column", gap: "24px" }}>

              {/* КОНТАКТНІ ДАНІ */}
              <div style={{ backgroundColor: "#fff", borderRadius: "24px", padding: "32px" }}>
                <h2 style={{ fontSize: "18px", fontWeight: "700", margin: "0 0 24px 0", color: "#202124" }}>
                  Контактні дані
                </h2>
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "16px" }}>
                  <div>
                    <label style={labelStyle}>Ім'я *</label>
                    <input
                      type="text" name="firstName" value={form.firstName}
                      onChange={handleChange} placeholder="Олексій"
                      style={inputStyle} required
                    />
                  </div>
                  <div>
                    <label style={labelStyle}>Прізвище</label>
                    <input
                      type="text" name="lastName" value={form.lastName}
                      onChange={handleChange} placeholder="Коваленко"
                      style={inputStyle}
                    />
                  </div>
                  <div>
                    <label style={labelStyle}>Телефон *</label>
                    <input
                      type="tel" name="phone" value={form.phone}
                      onChange={handleChange} placeholder="+380..."
                      style={inputStyle} required
                    />
                  </div>
                  <div>
                    <label style={labelStyle}>Email</label>
                    <input
                      type="email" name="email" value={form.email}
                      onChange={handleChange} placeholder="example@gmail.com"
                      style={inputStyle}
                    />
                  </div>
                </div>
              </div>

              {/* АДРЕСА ДОСТАВКИ */}
              <div style={{ backgroundColor: "#fff", borderRadius: "24px", padding: "32px" }}>
                <h2 style={{ fontSize: "18px", fontWeight: "700", margin: "0 0 24px 0", color: "#202124" }}>
                  Адреса доставки
                </h2>
                <div>
                  <label style={labelStyle}>Адреса *</label>
                  <input
                    type="text" name="address" value={form.address}
                    onChange={handleChange} placeholder="вул. Хрещатик, 1, Київ"
                    style={inputStyle} required
                  />
                </div>
              </div>

              {/* СПОСІБ ОПЛАТИ */}
              <div style={{ backgroundColor: "#fff", borderRadius: "24px", padding: "32px" }}>
                <h2 style={{ fontSize: "18px", fontWeight: "700", margin: "0 0 24px 0", color: "#202124" }}>
                  Спосіб оплати
                </h2>
                <div style={{ display: "flex", flexDirection: "column", gap: "12px" }}>
                  {[
                    { value: "card", label: "Картка онлайн" },
                    { value: "cash", label: "Готівка при отриманні" },
                    { value: "terminal", label: "Термінал при отриманні" },
                  ].map((option) => (
                    <label
                      key={option.value}
                      style={{ display: "flex", alignItems: "center", gap: "12px", cursor: "pointer", padding: "14px 16px", borderRadius: "12px", border: form.paymentMethod === option.value ? "2px solid #10b981" : "2px solid #e0e0e0", backgroundColor: form.paymentMethod === option.value ? "#f0fdf4" : "#fafafa" }}
                    >
                      <input
                        type="radio" name="paymentMethod" value={option.value}
                        checked={form.paymentMethod === option.value}
                        onChange={handleChange}
                        style={{ accentColor: "#10b981" }}
                      />
                      <span style={{ fontSize: "15px", fontWeight: "600", color: "#202124" }}>{option.label}</span>
                    </label>
                  ))}
                </div>

                {/* ✅ Підказка про тестову оплату Stripe — щоб на демонстрації
                    було зрозуміло звідки взяти номер картки */}
                {form.paymentMethod === "card" && (
                  <div style={{ marginTop: "16px", padding: "14px 16px", backgroundColor: "#eff6ff", borderRadius: "12px", border: "1px solid #bfdbfe" }}>
                    <p style={{ fontSize: "13px", color: "#1e40af", margin: 0, lineHeight: "1.5" }}>
                      💳 Оплата через Stripe (тестовий режим). Для перевірки введіть
                      номер картки <strong>4242 4242 4242 4242</strong>, будь-яку
                      майбутню дату та будь-який CVC.
                    </p>
                  </div>
                )}
              </div>

              {/* КОМЕНТАР */}
              <div style={{ backgroundColor: "#fff", borderRadius: "24px", padding: "32px" }}>
                <h2 style={{ fontSize: "18px", fontWeight: "700", margin: "0 0 24px 0", color: "#202124" }}>
                  Коментар до замовлення
                </h2>
                <textarea
                  name="comment" value={form.comment} onChange={handleChange}
                  placeholder="Додаткові побажання..."
                  style={{ ...inputStyle, height: "100px", resize: "vertical", fontFamily: "inherit" }}
                />
              </div>

            </div>

            {/* ПРАВА ЧАСТИНА — ПІДСУМОК */}
            <div style={{ width: "380px", position: "sticky", top: "40px" }}>
              <div style={{ backgroundColor: "#fff", borderRadius: "24px", padding: "32px", boxShadow: "0 8px 32px rgba(0,0,0,0.04)" }}>
                <h2 style={{ fontSize: "20px", fontWeight: "800", margin: "0 0 24px 0", color: "#202124" }}>
                  Ваше замовлення
                </h2>

                {/* СПИСОК ТОВАРІВ */}
                <div style={{ display: "flex", flexDirection: "column", gap: "16px", marginBottom: "24px" }}>
                  {cartItems.map((item) => (
                    <div key={item.id} style={{ display: "flex", alignItems: "center", gap: "12px" }}>
                      <div style={{ width: "48px", height: "48px", borderRadius: "8px", border: "1px solid #f0f0f0", overflow: "hidden", flexShrink: 0 }}>
                        <img src={item.image} alt={item.name || item.title} style={{ width: "100%", height: "100%", objectFit: "contain" }} onError={(e) => { e.target.style.display = "none"; }} />
                      </div>
                      <div style={{ flex: 1 }}>
                        <div style={{ fontSize: "13px", fontWeight: "600", color: "#202124", lineHeight: "1.3" }}>
                          {item.name || item.title}
                        </div>
                        <div style={{ fontSize: "12px", color: "#888" }}>× {item.quantity}</div>
                      </div>
                      <div style={{ fontSize: "14px", fontWeight: "700", color: "#202124", whiteSpace: "nowrap" }}>
                        {(Number(item.price) * item.quantity).toFixed(2)} грн
                      </div>
                    </div>
                  ))}
                </div>

                <div style={{ borderTop: "1px solid #f0f0f0", paddingTop: "16px", display: "flex", flexDirection: "column", gap: "12px", marginBottom: "24px" }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: "14px", color: "#555" }}>
                    <span>Сума товарів</span>
                    <span style={{ fontWeight: "600" }}>{subtotal.toFixed(2)} грн</span>
                  </div>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: "14px", color: "#555" }}>
                    <span>Доставка</span>
                    <span style={{ fontWeight: "600" }}>{deliveryCost.toFixed(2)} грн</span>
                  </div>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: "18px", fontWeight: "800", color: "#202124", paddingTop: "8px", borderTop: "1px solid #f0f0f0" }}>
                    <span>Разом</span>
                    <span>{total.toFixed(2)} грн</span>
                  </div>
                </div>

                {error && (
                  <div style={{ backgroundColor: "#fef2f2", border: "1px solid #fecaca", borderRadius: "12px", padding: "12px 16px", marginBottom: "16px", color: "#dc2626", fontSize: "14px", fontWeight: "500" }}>
                    {error}
                  </div>
                )}

                <button
                  type="submit"
                  disabled={isSubmitting}
                  style={{ width: "100%", backgroundColor: isSubmitting ? "#9ca3af" : "#10b981", color: "#fff", border: "none", borderRadius: "16px", padding: "16px", fontSize: "16px", fontWeight: "700", cursor: isSubmitting ? "not-allowed" : "pointer" }}
                >
                  {isSubmitting
                    ? (form.paymentMethod === "card" ? "Перенаправлення на оплату..." : "Оформляємо...")
                    : (form.paymentMethod === "card" ? "Перейти до оплати" : "Підтвердити замовлення")}
                </button>

                <p style={{ fontSize: "12px", color: "#888", textAlign: "center", marginTop: "12px", lineHeight: "1.4" }}>
                  Натискаючи кнопку, ви погоджуєтесь з умовами використання сервісу
                </p>
              </div>
            </div>

          </div>
        </form>

      </div>
    </div>
  );
}
</file>

<file path="frontend/src/styles/global.css">
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

:root {
  --green: #159447;
  --green-dark: #0d6c31;
  --yellow: #fdd835;
  --yellow-light: #fff8e1;
  --text: #1f1f1f;
  --muted: #666666;
  --bg: #f5f5f5;
  --white: #ffffff;
  --border: #dddddd;
}

html,
body,
#root {
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
}

body {
  margin: 0;
}

a {
  text-decoration: none;
  color: inherit;
}

button,
input,
select,
textarea {
  font: inherit;
}

.page-container {
  min-height: calc(100vh - 140px);
}

/* HEADER */
.header {
  display: grid;
  grid-template-columns: 140px auto 1fr auto;
  align-items: center;
  gap: 20px;
  padding: 15px 40px;
  background: var(--yellow);
  border-bottom: 1px solid #e0c22d;
  position: sticky;
  top: 0;
  z-index: 50;
}

.logo {
  font-size: 24px;
  font-weight: bold;
}

.nav {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.nav a {
  color: black;
}

.search {
  min-width: 0;
}

.search input {
  width: 100%;
  min-height: 44px;
  padding: 10px 14px;
  border: 1px solid #d0d0d0;
  border-radius: 12px;
  outline: none;
  background: white;
}

.user-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.header-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.header-button--light {
  background: white;
  border: 1px solid #d0d0d0;
}

.header-button--green {
  background: var(--green);
  color: white;
}

/* HOME */
.hero {
  text-align: center;
  padding: 80px 20px;
  background: var(--yellow-light);
}

.hero__content {
  max-width: 900px;
  margin: 0 auto;
}

.hero h1 {
  font-size: 46px;
  margin-bottom: 14px;
}

.hero p {
  font-size: 20px;
  color: #444444;
  margin-bottom: 24px;
}

.hero-button {
  min-width: 220px;
}

.categories,
.products,
.catalog-page,
.simple-page,
.cart-page,
.product-page,
.checkout-page {
  max-width: 1280px;
  margin: 0 auto;
  padding: 42px 32px;
}

.categories h2,
.products h2,
.section-title h1,
.section-title h2,
.simple-page h1 {
  margin-bottom: 20px;
  font-size: 36px;
}

.section-title {
  margin-bottom: 24px;
}

.section-title p,
.simple-page p {
  color: var(--muted);
  font-size: 18px;
}

.category-list,
.product-grid,
.products-grid,
.catalog-grid {
  display: grid;
  gap: 20px;
}

.category-list {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.product-grid,
.products-grid,
.catalog-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.category-card {
  border: 1px solid var(--border);
  padding: 20px;
  text-align: center;
  background: white;
  border-radius: 16px;
  font-size: 18px;
  font-weight: 700;
}

.category-card--link {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.category-card--link:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
}

.green-button,
.white-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 20px;
  border-radius: 12px;
  font-weight: 700;
  border: none;
  cursor: pointer;
}

.green-button {
  background: var(--green);
  color: white;
}

.green-button:hover {
  background: var(--green-dark);
}

.white-button {
  background: white;
  color: var(--text);
  border: 1px solid var(--border);
}

/* PRODUCT CARD */
.product-card {
  border: 1px solid var(--border);
  border-radius: 18px;
  background: white;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 18px rgba(0, 0, 0, 0.08);
}

.product-card__image-link {
  display: block;
}

.product-card__image {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
  background: #efefef;
}

.product-card__content {
  padding: 16px;
  display: flex;
  flex-direction: column;
  min-height: 220px;
}

.product-card__category {
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 8px;
}

.product-card__title-link {
  display: block;
}

.product-card__title {
  margin-bottom: 12px;
  font-size: 24px;
}

.product-card__price {
  margin-bottom: 16px;
  font-size: 22px;
  font-weight: 700;
}

.product-card__actions {
  margin-top: auto;
}

/* CATALOG */
.catalog-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 24px;
}

.catalog-sidebar {
  background: white;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 24px;
  height: fit-content;
}

.catalog-sidebar__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.catalog-sidebar h3 {
  font-size: 24px;
}

.catalog-clear-button {
  border: none;
  background: transparent;
  color: var(--green);
  font-weight: 700;
  cursor: pointer;
}

.catalog-search-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.catalog-search-input {
  width: 100%;
  min-height: 46px;
  padding: 12px 14px;
  border: 1px solid #d9d9d9;
  border-radius: 12px;
  outline: none;
}

.catalog-search-button {
  width: 100%;
}

.filter-group + .filter-group {
  margin-top: 22px;
}

.filter-title {
  margin-bottom: 12px;
  font-weight: 700;
}

.filter-label {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  color: #444444;
}

.catalog-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.catalog-sort {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 240px;
}

.catalog-sort label {
  font-weight: 700;
}

.catalog-sort select {
  min-height: 46px;
  padding: 10px 14px;
  border: 1px solid #d9d9d9;
  border-radius: 12px;
  background: white;
  outline: none;
}

.catalog-active-filters {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.catalog-chip {
  border: none;
  background: #e8f6ed;
  color: var(--green);
  padding: 8px 12px;
  border-radius: 999px;
  font-weight: 700;
  cursor: pointer;
}

.catalog-results-count {
  margin-bottom: 20px;
  color: var(--muted);
  font-size: 16px;
}

.catalog-empty {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 40px 28px;
  text-align: center;
}

.catalog-empty h2 {
  margin-bottom: 12px;
  font-size: 30px;
}

.catalog-empty p {
  color: var(--muted);
  font-size: 17px;
}

/* AUTH */
.auth-page {
  max-width: 1280px;
  margin: 0 auto;
  padding: 48px 32px;
}

.auth-wrapper {
  display: grid;
  grid-template-columns: 1fr 460px;
  gap: 28px;
  align-items: stretch;
}

.auth-info {
  background: #fff8e1;
  border-radius: 24px;
  padding: 40px;
}

.auth-badge {
  display: inline-block;
  padding: 8px 14px;
  border-radius: 999px;
  background: white;
  color: var(--green);
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 18px;
}

.auth-info h1 {
  margin-bottom: 16px;
  font-size: 42px;
  line-height: 1.1;
}

.auth-info p {
  margin-bottom: 22px;
  font-size: 18px;
  line-height: 1.6;
  color: #4e4e4e;
}

.auth-benefits {
  padding-left: 20px;
}

.auth-benefits li {
  margin-bottom: 12px;
  font-size: 17px;
}

.auth-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 32px;
}

.auth-card h2 {
  margin-bottom: 22px;
  font-size: 30px;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.auth-label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-weight: 600;
}

.auth-input {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid #d9d9d9;
  border-radius: 12px;
  outline: none;
  background: white;
}

.auth-submit {
  width: 100%;
  margin-top: 8px;
}

.auth-links {
  margin-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.auth-links a {
  color: var(--green);
  font-weight: 600;
}

/* CART */
.cart-layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 24px;
  align-items: start;
}

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.cart-item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 18px;
  display: grid;
  grid-template-columns: 140px 1fr auto;
  gap: 20px;
  align-items: center;
}

.cart-item__image {
  width: 140px;
  height: 140px;
  object-fit: cover;
  border-radius: 16px;
  background: #efefef;
}

.cart-item__content h3 {
  margin-bottom: 10px;
  font-size: 24px;
}

.cart-item__price {
  margin-bottom: 18px;
  color: var(--muted);
  font-size: 17px;
}

.cart-item__actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.quantity-box {
  display: inline-flex;
  align-items: center;
  background: #f3f3f3;
  border-radius: 14px;
  overflow: hidden;
}

.quantity-box button {
  width: 42px;
  height: 42px;
  border: none;
  background: transparent;
  font-size: 22px;
  cursor: pointer;
}

.quantity-box span {
  min-width: 42px;
  text-align: center;
  font-weight: 700;
}

.remove-button {
  border: none;
  background: transparent;
  color: #c63f3f;
  font-weight: 700;
  cursor: pointer;
}

.cart-item__total {
  font-size: 24px;
  font-weight: 700;
  white-space: nowrap;
}

.cart-summary {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 24px;
  position: sticky;
  top: 120px;
}

.cart-summary h2 {
  margin-bottom: 20px;
  font-size: 30px;
}

.cart-summary__row {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.cart-summary__row--total {
  font-size: 20px;
  border-bottom: none;
  padding-top: 18px;
}

.cart-summary__button {
  width: 100%;
  margin-top: 18px;
}

.cart-summary__clear {
  width: 100%;
  margin-top: 12px;
  min-height: 46px;
  border-radius: 12px;
  border: 1px solid #d9d9d9;
  background: white;
  font-weight: 700;
  cursor: pointer;
}

.cart-summary__link {
  display: block;
  text-align: center;
  margin-top: 14px;
  color: var(--green);
  font-weight: 700;
}

.cart-empty {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 48px 32px;
  text-align: center;
}

.cart-empty h1 {
  margin-bottom: 14px;
  font-size: 38px;
}

.cart-empty p {
  max-width: 600px;
  margin: 0 auto 24px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
}

/* PRODUCT PAGE */
.product-details {
  display: grid;
  grid-template-columns: 520px 1fr;
  gap: 28px;
  align-items: start;
}

.product-details__image-box {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 24px;
}

.product-details__image {
  width: 100%;
  height: 460px;
  object-fit: cover;
  border-radius: 18px;
  background: #efefef;
}

.product-details__info {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 32px;
}

.product-details__category {
  margin-bottom: 10px;
  color: var(--muted);
  font-size: 15px;
}

.product-details__info h1 {
  margin-bottom: 12px;
  font-size: 42px;
}

.product-details__weight {
  margin-bottom: 18px;
  font-size: 18px;
  font-weight: 700;
}

.product-details__description {
  margin-bottom: 28px;
  font-size: 18px;
  line-height: 1.7;
  color: #4c4c4c;
}

.product-details__buy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 0;
  border-top: 1px solid #f0f0f0;
  border-bottom: 1px solid #f0f0f0;
}

.product-details__price {
  font-size: 36px;
  font-weight: 700;
  white-space: nowrap;
}

.product-details__controls {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.product-details__button {
  min-width: 180px;
}

.product-details__meta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 24px;
}

.product-meta-card {
  background: #fafafa;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
}

.product-meta-card h3 {
  margin-bottom: 10px;
  font-size: 20px;
}

.product-meta-card p {
  color: var(--muted);
  line-height: 1.5;
}

.related-products {
  margin-top: 42px;
}

.product-not-found {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 48px 32px;
  text-align: center;
}

.product-not-found h1 {
  margin-bottom: 14px;
  font-size: 38px;
}

.product-not-found p {
  max-width: 650px;
  margin: 0 auto 24px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
}

/* CHECKOUT */
.checkout-layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 24px;
  align-items: start;
}

.checkout-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.checkout-block {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 24px;
}

.checkout-block h2 {
  margin-bottom: 20px;
  font-size: 28px;
}

.checkout-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.checkout-label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-weight: 600;
}

.checkout-label--full {
  grid-column: 1 / -1;
}

.checkout-label input,
.checkout-label textarea {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid #d9d9d9;
  border-radius: 12px;
  outline: none;
  resize: vertical;
}

.checkout-label textarea {
  min-height: 110px;
}

.checkout-radio-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.checkout-radio {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
}

.checkout-submit {
  width: 100%;
}

.checkout-summary {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 24px;
  position: sticky;
  top: 120px;
}

.checkout-summary h2 {
  margin-bottom: 20px;
  font-size: 30px;
}

.checkout-summary__items {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-bottom: 18px;
  border-bottom: 1px solid #f0f0f0;
}

.checkout-summary__item {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
}

.checkout-summary__name {
  margin-bottom: 6px;
  font-weight: 700;
}

.checkout-summary__meta {
  color: var(--muted);
  font-size: 14px;
}

.checkout-summary__totals {
  padding-top: 18px;
}

.checkout-summary__row {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  padding: 10px 0;
}

.checkout-summary__row--total {
  font-size: 20px;
  font-weight: 700;
}

.checkout-empty,
.checkout-success {
  background: white;
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 48px 32px;
  text-align: center;
}

.checkout-empty h1,
.checkout-success h1 {
  margin-bottom: 14px;
  font-size: 38px;
}

.checkout-empty p,
.checkout-success p {
  max-width: 700px;
  margin: 0 auto 24px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
}

.checkout-success__actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

/* SIMPLE */
.simple-page h1 {
  margin-bottom: 12px;
  font-size: 34px;
}

.simple-page p {
  color: var(--muted);
  font-size: 18px;
}

/* FOOTER */
.footer {
  text-align: center;
  padding: 20px;
  background: var(--yellow);
  color: black;
  margin-top: 20px;
}

/* ADAPTIVE */
@media (max-width: 1200px) {
  .header {
    grid-template-columns: 140px 1fr;
  }

  .nav {
    grid-column: 1 / -1;
    order: 3;
  }

  .user-actions {
    justify-self: end;
  }

  .product-grid,
  .products-grid,
  .catalog-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 1100px) {
  .catalog-layout,
  .cart-layout,
  .product-details,
  .checkout-layout {
    grid-template-columns: 1fr;
  }

  .cart-summary,
  .checkout-summary {
    position: static;
  }

  .product-details__image {
    height: 380px;
  }
}

@media (max-width: 980px) {
  .auth-wrapper {
    grid-template-columns: 1fr;
  }

  .category-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-grid,
  .products-grid,
  .catalog-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .header {
    grid-template-columns: 1fr;
    padding: 15px 20px;
  }

  .hero,
  .categories,
  .products,
  .catalog-page,
  .simple-page,
  .cart-page,
  .product-page,
  .checkout-page {
    padding: 36px 20px;
  }

  .hero {
    padding-top: 50px;
  }

  .hero h1 {
    font-size: 36px;
  }

  .hero p {
    font-size: 18px;
  }

  .category-list,
  .product-grid,
  .products-grid,
  .catalog-grid {
    grid-template-columns: 1fr;
  }

  .auth-info,
  .auth-card,
  .product-details__info,
  .product-details__image-box,
  .checkout-block,
  .checkout-summary {
    padding: 24px;
  }

  .auth-info h1 {
    font-size: 34px;
  }

  .cart-item {
    grid-template-columns: 1fr;
  }

  .cart-item__image {
    width: 100%;
    height: 220px;
  }

  .cart-item__total {
    font-size: 22px;
  }

  .product-details__info h1 {
    font-size: 34px;
  }

  .product-details__buy {
    flex-direction: column;
    align-items: flex-start;
  }

  .product-details__meta {
    grid-template-columns: 1fr;
  }

  .product-details__image {
    height: 300px;
  }

  .checkout-grid {
    grid-template-columns: 1fr;
  }

  .checkout-label--full {
    grid-column: auto;
  }
  .auth-success-message {
  margin-top: 16px;
  color: #0d6c31;
  font-weight: 700;
}

.auth-error-message {
  margin-top: 16px;
  color: #c63f3f;
  font-weight: 700;
}
}
