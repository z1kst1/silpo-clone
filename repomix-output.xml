}

.profile-container .page-subtitle {
  color: #777;
  margin: 0 0 20px 0;
  font-size: 13px;
}

/* КАРТКА ПРИВІТАННЯ */
.profile-container .welcome-card {
  background-color: #fff !important;
  border: 1px solid #eaeaea !important;
  border-radius: 12px !important;
  padding: 15px 20px;
  display: flex;
  justify-content: space-between;
