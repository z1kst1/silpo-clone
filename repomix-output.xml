            style={{ backgroundColor: "#f5f5f5", color: "#202124", padding: "16px 32px", borderRadius: "16px", textDecoration: "none", fontWeight: "600", fontSize: "15px", display: "block" }}
          >
            Переглянути замовлення у профілі
          </Link>
        </div>
      </div>
    </div>
  );
}
