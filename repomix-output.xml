            {cartItems.map((item) => {
              const itemPrice = Number(item.price) || 0;
              const itemTotal = itemPrice * item.quantity;
              const priceInt = Math.floor(itemTotal);
              const priceDecimal = (itemTotal % 1).toFixed(2).substring(2);

              return (
