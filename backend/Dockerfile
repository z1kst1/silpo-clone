# 1. Беремо легку версію Linux із вже встановленим Node.js
FROM node:22-alpine

# 2. Створюємо робочу папку всередині контейнера
WORKDIR /app

# 3. Копіюємо файли з інформацією про залежності (бібліотеки)
COPY package*.json ./

# 4. Встановлюємо всі необхідні бібліотеки всередині контейнера
RUN npm install

# 5. Копіюємо весь інший код твого бекенду в контейнер
COPY . .

# 6. Генеруємо клієнт Prisma (обов'язково для роботи з базою в Докері)
RUN npx prisma generate

# 7. Відкриваємо порт 3000, на якому працює твій сервер
EXPOSE 3000

# 8. Команда для запуску твого сервера
CMD ["npm", "start"]
